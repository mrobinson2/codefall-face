# Codefall Face backend configuration.
# Copy to server/.env and set the values you need. The server loads this
# file at startup. Variables already set in the process environment win.

# ---- Azure Voice Live (primary voice provider) ----
# Microsoft Foundry resource endpoint (HTTPS, without a path) and API key.
#AZURE_VOICE_LIVE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
#AZURE_VOICE_LIVE_KEY=your-key-here
#AZURE_VOICE_LIVE_MODEL=gpt-realtime
#AZURE_VOICE_LIVE_API_VERSION=2026-04-10
# Public hosting requires an authenticated TLS reverse proxy. Set a strong
# token and have the proxy inject it as Authorization: Bearer on the relay
# and its health route. Keep this token and the Azure key on servers.
#AZURE_VOICE_RELAY_TOKEN=choose-a-long-random-string
#ALLOWED_ORIGINS=https://YOUR-GAME.example

# ---- Lacy.ai (fallback provider) ----
#LACY_API_KEY=your-lacy-key
#LACY_BASE=https://app.lacy.ai/api
#LACY_REPLY_PATH=/user/ai/reply

# ---- agent hub (external orchestrators driving the face) ----
# Shared secret for /agent-hub (WS) and /api/face/* (HTTP).
# REQUIRED before exposing the hub beyond localhost:
#FACE_HUB_TOKEN=choose-a-long-random-string
# Where to POST face events (user transcripts, state changes) so your
# agent hears the human. Each event is one JSON object:
#FACE_EVENTS_WEBHOOK=https://your-agent-gateway/webhooks/codefall-face

# ---- Piper TTS (fully local neural voice) ----
# Run server/setup-piper.sh once; these defaults then just work.
# Override to use a different binary or voice model:
#PIPER_BIN=./piper-venv/bin/piper
#PIPER_VOICE=./voices/en_US-danny-low.onnx

# ---- server ----
PORT=8787
# Bind only to loopback by default. A reverse proxy on this host can connect here.
#CODEFALL_BIND_HOST=127.0.0.1
# Bounded request and WebSocket payloads.
MAX_JSON_BYTES=65536
MAX_WS_BYTES=262144
LOG_LEVEL=info
# Maximum graceful-shutdown window before forced termination.
SHUTDOWN_TIMEOUT_MS=10000
